# Gate for the VW Harrods gallery. The password is checked in a server action;
# the secret signs the cookie that the media route handler verifies.
GALLERY_PASSWORD=
GALLERY_SECRET=

# The Daily Canon's Supabase project. Server-only: read in a cached server
# fetch so the download and reader figures are live rather than hardcoded.
# Absent, the site falls back to the last known counts and still builds.
TDC_SUPABASE_URL=
TDC_SUPABASE_KEY=
